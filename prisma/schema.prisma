generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String
  photo       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  comments    Comment[]
  userAnswers UserAnswer[]
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  units       Unit[]
}

model Unit {
  id                     Int      @id @default(autoincrement())
  order                  Int
  title                  String
  description            String
  minEstimatedTimeInDays Int
  maxEstimatedTimeInDays Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  courseId               Int
  course                 Course   @relation(fields: [courseId], references: [id])
  lessons                Lesson[]
  exam                   Exam?
}

model Lesson {
  id              Int       @id @default(autoincrement())
  order           Int
  title           String
  content         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  unitId          Int
  unit            Unit      @relation(fields: [unitId], references: [id])
  materials       String[]
  videoSrc        String
  videoPoster     String?
  videoThumbnails String?
  comments        Comment[]
}

model Exam {
  id                Int        @id @default(autoincrement())
  title             String
  description       String
  createdAt         DateTime   @default(now())
  unitId            Int        @unique
  durationInMinutes Int        @default(10)
  unit              Unit       @relation(fields: [unitId], references: [id])
  questions         Question[]
}

model Question {
  id            Int          @id @default(autoincrement())
  text          String
  choices       String[]
  correctAnswer String
  createdAt     DateTime     @default(now())
  examId        Int
  exam          Exam         @relation(fields: [examId], references: [id])
  userAnswers   UserAnswer[]
}

model UserAnswer {
  id             Int      @id @default(autoincrement())
  selectedAnswer String
  isCorrect      Boolean
  createdAt      DateTime @default(now())
  userId         Int
  questionId     Int
  user           User     @relation(fields: [userId], references: [id])
  question       Question @relation(fields: [questionId], references: [id])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  userId    Int
  lessonId  Int
  user      User     @relation(fields: [userId], references: [id])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
}
